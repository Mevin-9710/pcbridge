# PCBridge Environment Variables
# Copy this file to .env.local and fill in your values

# Secret for signing session tokens (generate with: openssl rand -hex 32)
PCBRIDGE_SECRET=your-secret-here

# Cloud API URL (your Vercel deployment URL)
NEXT_PUBLIC_API_URL=https://your-app.vercel.app

# Shared state store (required on serverless hosts like Vercel).
# Without this, state is kept in memory per serverless instance, so paired
# devices/pending approvals can appear on one request and not another.
# Provision an Upstash Redis database (Vercel Marketplace -> Storage ->
# Upstash) and these variables are injected automatically. Both the
# Vercel KV (KV_*) and Upstash (UPSTASH_*) names are supported.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-token
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Node environment
NODE_ENV=development
